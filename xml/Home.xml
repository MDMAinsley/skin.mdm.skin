<?xml version='1.0' encoding='utf-8'?>
<window>
  <defaultcontrol>103</defaultcontrol>
  <onload>RunScript(special://skin/default.py)</onload>
  <onload>RunPlugin(plugin://plugin.video.mdm.flix/?action=library_home_list_label)</onload>
  <backgroundcolor>FF101014</backgroundcolor>
  <controls>
    <control type="group">
      <include>MDMArtworkHome</include>
      <visible>Skin.HasSetting(device_mdm_artwork)</visible>
    </control>
    <include>MDMInstalledVersions</include>
    <control type="label">
      <left>60</left>
      <top>45</top>
      <width>340</width>
      <height>85</height>
      <font>font60</font>
      <label>MDM</label>
      <textcolor>FFFFFFFF</textcolor>
    </control>
    <control type="label">
      <left>1510</left>
      <top>40</top>
      <width>300</width>
      <height>60</height>
      <font>font27</font>
      <label>$INFO[System.Time]</label>
      <textcolor>FFFFFFFF</textcolor>
    </control>
    <control type="label">
      <left>420</left>
      <top>125</top>
      <width>1350</width>
      <height>80</height>
      <font>font45</font>
      <label>Browse something worth watching.</label>
      <textcolor>FFFFFFFF</textcolor>
      <visible>!Skin.HasSetting(device_mdm_artwork)</visible>
    </control>
    <control type="label">
      <left>420</left>
      <top>220</top>
      <width>1370</width>
      <height>60</height>
      <font>font14</font>
      <label>Pick up where you left off, or find something new.</label>
      <textcolor>FFFFFFFF</textcolor>
      <visible>!Skin.HasSetting(device_mdm_artwork)</visible>
    </control>
    <control type="label">
      <left>420</left>
      <top>360</top>
      <width>1380</width>
      <height>60</height>
      <font>font27</font>
      <label>Basic mode — home artwork and widgets are off.</label>
      <textcolor>FFFFFFFF</textcolor>
      <visible>!Skin.HasSetting(device_mdm_artwork)</visible>
    </control>
    <control type="label">
      <left>420</left>
      <top>445</top>
      <width>1400</width>
      <height>65</height>
      <font>font13</font>
      <label>Use the menu to browse, search or open your list.</label>
      <textcolor>FFFFFFFF</textcolor>
      <visible>!Skin.HasSetting(device_mdm_artwork)</visible>
    </control>
    <control type="group">
      <animation type="Conditional" condition="$EXP[mdm_home_browsing]">
        <effect type="slide" end="-420,0" time="225" delay="70" tween="sine" easing="inout" />
        <effect type="fade" start="100" end="0" time="225" delay="70" tween="sine" easing="inout" />
      </animation>
      <control type="button" id="103">
        <left>60</left>
        <top>155</top>
        <width>340</width>
        <height>57</height>
        <label>Continue Watching</label>
        <font>font13</font>
        <textoffsetx>20</textoffsetx>
        <aligny>center</aligny>
        <focusedcolor>$VAR[MDMHomeAccentText]</focusedcolor>
        <onup condition="Player.HasMedia">111</onup>
        <onup condition="!Player.HasMedia">112</onup>
        <ondown>114</ondown>
        <onleft>103</onleft>
        <onback>103</onback>
        <texturefocus colordiffuse="$VAR[MDMHomeAccent]">colors/white.png</texturefocus>
        <texturenofocus colordiffuse="BB202024">colors/white.png</texturenofocus>
        <onclick>ActivateWindow(Videos,plugin://plugin.video.mdm.flix/?action=continue_watching,return)</onclick>
        <onright condition="Skin.HasSetting(device_mdm_artwork) + Integer.IsGreater(Container(5300).NumItems,0)">5300</onright>
        <onright condition="!Skin.HasSetting(device_mdm_artwork) | !Integer.IsGreater(Container(5300).NumItems,0)">noop</onright>
      </control>
      <control type="button" id="114">
        <left>60</left>
        <top>220</top>
        <width>340</width>
        <height>57</height>
        <label>Next Episodes</label>
        <font>font13</font>
        <textoffsetx>20</textoffsetx>
        <aligny>center</aligny>
        <focusedcolor>$VAR[MDMHomeAccentText]</focusedcolor>
        <onup>103</onup>
        <ondown>105</ondown>
        <onleft>114</onleft>
        <onback>103</onback>
        <texturefocus colordiffuse="$VAR[MDMHomeAccent]">colors/white.png</texturefocus>
        <texturenofocus colordiffuse="BB202024">colors/white.png</texturenofocus>
        <onclick>ActivateWindow(Videos,plugin://plugin.video.mdm.flix/?action=next_episodes,return)</onclick>
        <onright condition="Skin.HasSetting(device_mdm_artwork) + Integer.IsGreater(Container(5500).NumItems,0)">5500</onright>
        <onright condition="!Skin.HasSetting(device_mdm_artwork) | !Integer.IsGreater(Container(5500).NumItems,0)">noop</onright>
      </control>
      <control type="button" id="105">
        <left>60</left>
        <top>285</top>
        <width>340</width>
        <height>57</height>
        <label>$VAR[MDMHomeListLabel]</label>
        <font>font13</font>
        <textoffsetx>20</textoffsetx>
        <aligny>center</aligny>
        <focusedcolor>$VAR[MDMHomeAccentText]</focusedcolor>
        <onup>114</onup>
        <ondown>102</ondown>
        <onleft>105</onleft>
        <onback>103</onback>
        <texturefocus colordiffuse="$VAR[MDMHomeAccent]">colors/white.png</texturefocus>
        <texturenofocus colordiffuse="BB202024">colors/white.png</texturenofocus>
        <onclick>ActivateWindow(Videos,plugin://plugin.video.mdm.flix/?action=library_home_list,return)</onclick>
        <onright condition="Skin.HasSetting(device_mdm_artwork) + Integer.IsGreater(Container(5400).NumItems,0)">5400</onright>
        <onright condition="!Skin.HasSetting(device_mdm_artwork) | !Integer.IsGreater(Container(5400).NumItems,0)">noop</onright>
      </control>
      <control type="button" id="102">
        <left>60</left>
        <top>350</top>
        <width>340</width>
        <height>57</height>
        <label>Search</label>
        <font>font13</font>
        <textoffsetx>20</textoffsetx>
        <aligny>center</aligny>
        <focusedcolor>$VAR[MDMHomeAccentText]</focusedcolor>
        <onup>105</onup>
        <ondown>100</ondown>
        <onleft>102</onleft>
        <onback>103</onback>
        <texturefocus colordiffuse="$VAR[MDMHomeAccent]">colors/white.png</texturefocus>
        <texturenofocus colordiffuse="BB202024">colors/white.png</texturenofocus>
        <onclick>ActivateWindow(Videos,plugin://plugin.video.mdm.flix/?action=search&amp;input=1,return)</onclick>
        <onright>noop</onright>
      </control>
      <control type="button" id="100">
        <left>60</left>
        <top>415</top>
        <width>340</width>
        <height>57</height>
        <label>Films</label>
        <font>font13</font>
        <textoffsetx>20</textoffsetx>
        <aligny>center</aligny>
        <focusedcolor>$VAR[MDMHomeAccentText]</focusedcolor>
        <onup>102</onup>
        <ondown>101</ondown>
        <onleft>100</onleft>
        <onback>103</onback>
        <texturefocus colordiffuse="$VAR[MDMHomeAccent]">colors/white.png</texturefocus>
        <texturenofocus colordiffuse="BB202024">colors/white.png</texturenofocus>
        <onclick>ActivateWindow(Videos,plugin://plugin.video.mdm.flix/?action=movies,return)</onclick>
        <onright condition="Skin.HasSetting(device_mdm_artwork) + Integer.IsGreater(Container(5100).NumItems,0)">5100</onright>
        <onright condition="!Skin.HasSetting(device_mdm_artwork) | !Integer.IsGreater(Container(5100).NumItems,0)">noop</onright>
      </control>
      <control type="button" id="101">
        <left>60</left>
        <top>480</top>
        <width>340</width>
        <height>57</height>
        <label>TV</label>
        <font>font13</font>
        <textoffsetx>20</textoffsetx>
        <aligny>center</aligny>
        <focusedcolor>$VAR[MDMHomeAccentText]</focusedcolor>
        <onup>100</onup>
        <ondown>110</ondown>
        <onleft>101</onleft>
        <onback>103</onback>
        <texturefocus colordiffuse="$VAR[MDMHomeAccent]">colors/white.png</texturefocus>
        <texturenofocus colordiffuse="BB202024">colors/white.png</texturenofocus>
        <onclick>ActivateWindow(Videos,plugin://plugin.video.mdm.flix/?action=tvshows,return)</onclick>
        <onright condition="Skin.HasSetting(device_mdm_artwork) + Integer.IsGreater(Container(5200).NumItems,0)">5200</onright>
        <onright condition="!Skin.HasSetting(device_mdm_artwork) | !Integer.IsGreater(Container(5200).NumItems,0)">noop</onright>
      </control>
      <control type="button" id="110">
        <left>60</left>
        <top>570</top>
        <width>340</width>
        <height>57</height>
        <label>Refresh</label>
        <font>font13</font>
        <textoffsetx>20</textoffsetx>
        <aligny>center</aligny>
        <focusedcolor>$VAR[MDMHomeAccentText]</focusedcolor>
        <onup>101</onup>
        <ondown>113</ondown>
        <onleft>110</onleft>
        <onback>103</onback>
        <texturefocus colordiffuse="$VAR[MDMHomeAccent]">colors/white.png</texturefocus>
        <texturenofocus colordiffuse="BB202024">colors/white.png</texturenofocus>
        <onclick>UpdateAddonRepos()</onclick>
        <onclick>RunPlugin(plugin://plugin.video.mdm.flix/?action=mdblist_home_refresh)</onclick>
        <onclick>ReloadSkin()</onclick>
        <onright>noop</onright>
      </control>
      <control type="button" id="113">
        <left>60</left>
        <top>635</top>
        <width>340</width>
        <height>57</height>
        <label>$VAR[MDMHomeRepositoryLabel]</label>
        <font>font13</font>
        <textoffsetx>20</textoffsetx>
        <aligny>center</aligny>
        <focusedcolor>$VAR[MDMHomeAccentText]</focusedcolor>
        <onup>110</onup>
        <ondown>107</ondown>
        <onleft>113</onleft>
        <onback>103</onback>
        <texturefocus colordiffuse="$VAR[MDMHomeAccent]">colors/white.png</texturefocus>
        <texturenofocus colordiffuse="BB202024">colors/white.png</texturenofocus>
        <onclick>RunScript(special://skin/default.py,open_repository)</onclick>
        <onright>noop</onright>
      </control>
      <control type="button" id="107">
        <left>60</left>
        <top>700</top>
        <width>340</width>
        <height>57</height>
        <label>Settings</label>
        <font>font13</font>
        <textoffsetx>20</textoffsetx>
        <aligny>center</aligny>
        <focusedcolor>$VAR[MDMHomeAccentText]</focusedcolor>
        <onup>113</onup>
        <ondown>112</ondown>
        <onleft>107</onleft>
        <onback>103</onback>
        <texturefocus colordiffuse="$VAR[MDMHomeAccent]">colors/white.png</texturefocus>
        <texturenofocus colordiffuse="BB202024">colors/white.png</texturenofocus>
        <onclick>RunScript(special://skin/default.py,settings_menu)</onclick>
        <onright>noop</onright>
      </control>
      <control type="button" id="112">
        <left>60</left>
        <top>765</top>
        <width>340</width>
        <height>57</height>
        <label>Power</label>
        <font>font13</font>
        <textoffsetx>20</textoffsetx>
        <aligny>center</aligny>
        <focusedcolor>$VAR[MDMHomeAccentText]</focusedcolor>
        <onup>107</onup>
        <ondown condition="Player.HasMedia">111</ondown>
        <ondown condition="!Player.HasMedia">103</ondown>
        <onleft>112</onleft>
        <onback>103</onback>
        <texturefocus colordiffuse="$VAR[MDMHomeAccent]">colors/white.png</texturefocus>
        <texturenofocus colordiffuse="BB202024">colors/white.png</texturenofocus>
        <onclick>ActivateWindow(shutdownmenu)</onclick>
        <onright>noop</onright>
      </control>
      <control type="button" id="111">
        <left>60</left>
        <top>830</top>
        <width>340</width>
        <height>57</height>
        <label>Now playing</label>
        <font>font13</font>
        <textoffsetx>20</textoffsetx>
        <aligny>center</aligny>
        <focusedcolor>$VAR[MDMHomeAccentText]</focusedcolor>
        <onup>112</onup>
        <ondown>103</ondown>
        <onleft>111</onleft>
        <onback>103</onback>
        <texturefocus colordiffuse="$VAR[MDMHomeAccent]">colors/white.png</texturefocus>
        <texturenofocus colordiffuse="BB202024">colors/white.png</texturenofocus>
        <onclick>Action(FullScreen)</onclick>
        <visible>Player.HasMedia</visible>
        <onright>noop</onright>
      </control>
    </control>
  </controls>
</window>
