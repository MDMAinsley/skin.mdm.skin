<?xml version='1.0' encoding='utf-8'?>
<window>
  <defaultcontrol>103</defaultcontrol>
  <onload>RunScript(special://skin/default.py)</onload>
  <onload>RunPlugin(plugin://plugin.video.mdm.flix/?action=library_home_list_label)</onload>
  <backgroundcolor>FF101014</backgroundcolor>
  <controls>
    <include condition="Skin.HasSetting(device_mdm_artwork)">MDMArtworkHome</include>
    <include>MDMInstalledVersions</include>
    <control type="label">
      <left>60</left>
      <top>45</top>
      <width>340</width>
      <height>85</height>
      <font>font60</font>
      <label>MDM</label>
      <textcolor>FFFFFFFF</textcolor>
    </control>
    <control type="label">
      <left>1510</left>
      <top>40</top>
      <width>300</width>
      <height>60</height>
      <font>font27</font>
      <label>$INFO[System.Time]</label>
      <textcolor>FFFFFFFF</textcolor>
    </control>
    <control type="label">
      <left>420</left>
      <top>125</top>
      <width>1350</width>
      <height>80</height>
      <font>font45</font>
      <label>Browse something worth watching.</label>
      <textcolor>FFFFFFFF</textcolor>
      <visible>!Control.HasFocus(5100) + !Control.HasFocus(5200)</visible>
    </control>
    <control type="label">
      <left>420</left>
      <top>220</top>
      <width>1370</width>
      <height>60</height>
      <font>font14</font>
      <label>Pick up where you left off, or find something new.</label>
      <textcolor>FFFFFFFF</textcolor>
      <visible>!Control.HasFocus(5100) + !Control.HasFocus(5200)</visible>
    </control>
    <control type="label">
      <left>420</left>
      <top>360</top>
      <width>1380</width>
      <height>60</height>
      <font>font27</font>
      <label>Basic mode — home artwork and widgets are off.</label>
      <textcolor>FFFFFFFF</textcolor>
      <visible>!Skin.HasSetting(device_mdm_artwork)</visible>
    </control>
    <control type="label">
      <left>420</left>
      <top>445</top>
      <width>1400</width>
      <height>65</height>
      <font>font13</font>
      <label>Use the menu to browse, search or open your list.</label>
      <textcolor>FFFFFFFF</textcolor>
      <visible>!Skin.HasSetting(device_mdm_artwork)</visible>
    </control>
    <control type="button" id="103">
      <left>60</left>
      <top>155</top>
      <width>340</width>
      <height>57</height>
      <label>Continue Watching</label>
      <font>font13</font>
      <textoffsetx>20</textoffsetx>
      <aligny>center</aligny>
      <focusedcolor>$VAR[MDMHomeAccentText]</focusedcolor>
      <onup condition="Player.HasMedia">111</onup>
      <onup condition="!Player.HasMedia">112</onup>
      <ondown>105</ondown>
      <onleft>103</onleft>
      <onback>103</onback>
      <texturefocus colordiffuse="$VAR[MDMHomeAccent]">colors/white.png</texturefocus>
      <texturenofocus colordiffuse="BB202024">colors/white.png</texturenofocus>
      <onclick>ActivateWindow(Videos,plugin://plugin.video.mdm.flix/?action=continue_watching,return)</onclick>
      <onright condition="Skin.HasSetting(device_mdm_artwork) + Integer.IsGreater(Container(5100).NumItems,0)">5100</onright>
      <onright condition="Skin.HasSetting(device_mdm_artwork) + !Integer.IsGreater(Container(5100).NumItems,0) + Integer.IsGreater(Container(5200).NumItems,0)">5200</onright>
      <onright condition="!Skin.HasSetting(device_mdm_artwork) | [!Integer.IsGreater(Container(5100).NumItems,0) + !Integer.IsGreater(Container(5200).NumItems,0)]">103</onright>
    </control>
    <control type="button" id="105">
      <left>60</left>
      <top>220</top>
      <width>340</width>
      <height>57</height>
