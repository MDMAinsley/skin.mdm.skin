<?xml version='1.0' encoding='utf-8'?>
<includes>
  <variable name="MDMHomeListLabel">
    <value condition="!String.IsEmpty(Window(home).Property(mdm_home_list_label))">$INFO[Window(home).Property(mdm_home_list_label)]</value>
    <value>My List</value>
  </variable>
  <variable name="MDMHomeAccent">
    <value condition="!String.IsEmpty(Window(home).Property(mdm_home_accent))">$INFO[Window(home).Property(mdm_home_accent)]</value>
    <value>FFE50914</value>
  </variable>
  <variable name="MDMHomeAccentText">
    <value condition="!String.IsEmpty(Window(home).Property(mdm_home_accent_text))">$INFO[Window(home).Property(mdm_home_accent_text)]</value>
    <value>FFFFFFFF</value>
  </variable>
  <include name="MDMInstalledVersion">
    <definition>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>278</width>
        <height>30</height>
        <aligny>center</aligny>
        <font>font10</font>
        <textcolor>FFF0F0F0</textcolor>
        <label>MDM [COLOR $PARAM[color]]$PARAM[name][/COLOR]: $INFO[System.AddonVersion($PARAM[id])]</label>
        <visible>!String.IsEmpty(System.AddonVersion($PARAM[id]))</visible>
      </control>
    </definition>
  </include>
  <include name="MDMInstalledVersions">
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>125</height>
      <texture colordiffuse="E6101014">colors/white.png</texture>
    </control>
    <include content="MDMInstalledVersion">
      <param name="id" value="plugin.video.mdm.flix" />
      <param name="name" value="Flix" />
      <param name="color" value="FFC78CFF" />
      <param name="left" value="350" />
      <param name="top" value="42" />
    </include>
    <include content="MDMInstalledVersion">
      <param name="id" value="script.mdm.link" />
      <param name="name" value="Link" />
      <param name="color" value="FFF2E85E" />
      <param name="left" value="632" />
      <param name="top" value="42" />
    </include>
    <include content="MDMInstalledVersion">
      <param name="id" value="script.mdm.core" />
      <param name="name" value="Core" />
      <param name="color" value="FF88ACFF" />
      <param name="left" value="914" />
      <param name="top" value="42" />
    </include>
    <include content="MDMInstalledVersion">
      <param name="id" value="script.mdm.conf" />
      <param name="name" value="Conf" />
      <param name="color" value="FF9DE76D" />
      <param name="left" value="1196" />
      <param name="top" value="42" />
    </include>
    <include content="MDMInstalledVersion">
      <param name="id" value="skin.mdm.skin" />
      <param name="name" value="Skin" />
      <param name="color" value="FFFFAB68" />
      <param name="left" value="350" />
      <param name="top" value="76" />
    </include>
    <include content="MDMInstalledVersion">
      <param name="id" value="repository.mdm.repo" />
      <param name="name" value="Repo" />
      <param name="color" value="FFFF8188" />
      <param name="left" value="632" />
      <param name="top" value="76" />
    </include>
    <include content="MDMInstalledVersion">
      <param name="id" value="repository.mdm.repo.dev" />
      <param name="name" value="Dev Repo" />
      <param name="color" value="FFFF8188" />
      <param name="left" value="914" />
      <param name="top" value="76" />
    </include>
  </include>
  <include name="MDMArtworkHome">
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <aspectratio>scale</aspectratio>
      <texture colordiffuse="55FFFFFF">$INFO[Container(5100).ListItem.Art(fanart)]</texture>
      <visible>Control.HasFocus(5100)</visible>
    </control>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <aspectratio>scale</aspectratio>
      <texture colordiffuse="55FFFFFF">$INFO[Container(5200).ListItem.Art(fanart)]</texture>
      <visible>Control.HasFocus(5200)</visible>
    </control>
    <control type="label">
      <left>420</left>
      <top>405</top>
      <width>1350</width>
      <height>50</height>
      <font>font27</font>
      <label>Trending films</label>
      <textcolor>FFFFFFFF</textcolor>
    </control>
    <control type="panel" id="5100">
      <left>420</left>
      <top>460</top>
      <width>1440</width>
      <height>245</height>
      <orientation>horizontal</orientation>
      <scrolltime>150</scrolltime>
      <preloaditems>1</preloaditems>
      <onleft>103</onleft>
      <onright>noop</onright>
      <onback>103</onback>
      <visible>true</visible>
      <itemlayout width="160" height="245">
        <control type="image">
          <left>5</left>
          <top>5</top>
          <width>144</width>
          <height>206</height>
          <aspectratio>keep</aspectratio>
          <texture fallback="DefaultVideo.png">$INFO[ListItem.Art(poster)]</texture>
        </control>
        <control type="label">
          <left>5</left>
          <top>213</top>
          <width>146</width>
          <height>32</height>
          <font>font10</font>
          <label>$INFO[ListItem.Label]</label>
          <textcolor>FFFFFFFF</textcolor>
        </control>
      </itemlayout>
      <focusedlayout width="160" height="245">
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>154</width>
          <height>216</height>
          <texture colordiffuse="$VAR[MDMHomeAccent]">colors/white.png</texture>
        </control>
        <control type="image">
          <left>5</left>
          <top>5</top>
          <width>144</width>
          <height>206</height>
          <aspectratio>keep</aspectratio>
          <texture fallback="DefaultVideo.png">$INFO[ListItem.Art(poster)]</texture>
        </control>
        <control type="label">
          <left>5</left>
          <top>213</top>
          <width>146</width>
          <height>32</height>
          <font>font10</font>
          <label>$INFO[ListItem.Label]</label>
          <textcolor>FFFFFFFF</textcolor>
        </control>
      </focusedlayout>
      <content target="videos" limit="12" browse="never">$VAR[MDMWidgetMovieURL]</content>
      <onup>103</onup>
      <ondown condition="Integer.IsGreater(Container(5200).NumItems,0)">5200</ondown>
      <ondown condition="!Integer.IsGreater(Container(5200).NumItems,0)">103</ondown>
    </control>
    <control type="label">
      <left>420</left>
      <top>515</top>
      <width>1100</width>
      <height>50</height>
      <font>font13</font>
      <label>Loading…</label>
      <textcolor>FFFFFFFF</textcolor>
      <visible>Container(5100).IsUpdating</visible>
    </control>
    <control type="label">
      <left>420</left>
      <top>515</top>
      <width>1400</width>
      <height>50</height>
      <font>font12</font>
      <label>No titles yet. Open Settings → Flix settings to check TMDB, then use Refresh.</label>
      <textcolor>FFFFFFFF</textcolor>
      <visible>!Container(5100).IsUpdating + Integer.IsEqual(Container(5100).NumItems,0)</visible>
    </control>
    <control type="label">
      <left>420</left>
      <top>130</top>
      <width>1400</width>
      <height>75</height>
      <font>font45</font>
      <label>$INFO[Container(5100).ListItem.Label]</label>
      <textcolor>FFFFFFFF</textcolor>
      <visible>Control.HasFocus(5100)</visible>
    </control>
    <control type="textbox">
      <left>420</left>
      <top>220</top>
      <width>1370</width>
      <height>150</height>
      <font>font13</font>
      <label>$INFO[Container(5100).ListItem.Plot]</label>
      <visible>Control.HasFocus(5100)</visible>
    </control>
    <control type="label">
      <left>420</left>
      <top>725</top>
      <width>1350</width>
      <height>50</height>
      <font>font27</font>
      <label>Trending TV</label>
      <textcolor>FFFFFFFF</textcolor>
    </control>
    <control type="panel" id="5200">
      <left>420</left>
      <top>780</top>
      <width>1440</width>
      <height>245</height>
      <orientation>horizontal</orientation>
      <scrolltime>150</scrolltime>
      <preloaditems>1</preloaditems>
      <onleft>103</onleft>
      <onright>noop</onright>
      <onback>103</onback>
      <visible>true</visible>
      <itemlayout width="160" height="245">
        <control type="image">
          <left>5</left>
          <top>5</top>
          <width>144</width>
          <height>206</height>
          <aspectratio>keep</aspectratio>
          <texture fallback="DefaultVideo.png">$INFO[ListItem.Art(poster)]</texture>
        </control>
        <control type="label">
          <left>5</left>
          <top>213</top>
          <width>146</width>
          <height>32</height>
          <font>font10</font>
          <label>$INFO[ListItem.Label]</label>
          <textcolor>FFFFFFFF</textcolor>
        </control>
      </itemlayout>
      <focusedlayout width="160" height="245">
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>154</width>
          <height>216</height>
          <texture colordiffuse="$VAR[MDMHomeAccent]">colors/white.png</texture>
        </control>
        <control type="image">
          <left>5</left>
          <top>5</top>
          <width>144</width>
          <height>206</height>
          <aspectratio>keep</aspectratio>
          <texture fallback="DefaultVideo.png">$INFO[ListItem.Art(poster)]</texture>
        </control>
        <control type="label">
          <left>5</left>
          <top>213</top>
          <width>146</width>
          <height>32</height>
          <font>font10</font>
          <label>$INFO[ListItem.Label]</label>
          <textcolor>FFFFFFFF</textcolor>
        </control>
      </focusedlayout>
      <content target="videos" limit="12" browse="never">$VAR[MDMWidgetTVURL]</content>
      <onup condition="Integer.IsGreater(Container(5100).NumItems,0)">5100</onup>
      <onup condition="!Integer.IsGreater(Container(5100).NumItems,0)">103</onup>
      <ondown>103</ondown>
    </control>
    <control type="label">
      <left>420</left>
      <top>835</top>
      <width>1100</width>
      <height>50</height>
      <font>font13</font>
      <label>Loading…</label>
      <textcolor>FFFFFFFF</textcolor>
      <visible>Container(5200).IsUpdating</visible>
    </control>
    <control type="label">
      <left>420</left>
      <top>835</top>
      <width>1400</width>
      <height>50</height>
      <font>font12</font>
      <label>No titles yet. Open Settings → Flix settings to check TMDB, then use Refresh.</label>
      <textcolor>FFFFFFFF</textcolor>
      <visible>!Container(5200).IsUpdating + Integer.IsEqual(Container(5200).NumItems,0)</visible>
    </control>
    <control type="label">
      <left>420</left>
      <top>130</top>
      <width>1400</width>
      <height>75</height>
      <font>font45</font>
      <label>$INFO[Container(5200).ListItem.Label]</label>
      <textcolor>FFFFFFFF</textcolor>
      <visible>Control.HasFocus(5200)</visible>
    </control>
    <control type="textbox">
      <left>420</left>
      <top>220</top>
      <width>1370</width>
      <height>150</height>
      <font>font13</font>
      <label>$INFO[Container(5200).ListItem.Plot]</label>
      <visible>Control.HasFocus(5200)</visible>
    </control>
  </include>
  <variable name="MDMWidgetMovieURL">
    <value condition="!String.IsEmpty(Window(home).Property(mdm_widget_mode))">plugin://plugin.video.mdm.flix/?action=skin_widget&amp;media_type=movie&amp;mode=$INFO[Window(home).Property(mdm_widget_mode)]</value>
    <value />
  </variable>
  <variable name="MDMWidgetTVURL">
    <value condition="!String.IsEmpty(Window(home).Property(mdm_widget_mode))">plugin://plugin.video.mdm.flix/?action=skin_widget&amp;media_type=tv&amp;mode=$INFO[Window(home).Property(mdm_widget_mode)]</value>
    <value />
  </variable>
</includes>