<?xml version='1.0' encoding='utf-8'?>
<includes>
  <variable name="MDMHomeListLabel">
    <value condition="!String.IsEmpty(Window(home).Property(mdm_home_list_label))">$INFO[Window(home).Property(mdm_home_list_label)]</value>
    <value>My List</value>
  </variable>
  <variable name="MDMHomeRepositoryLabel">
    <value condition="!String.IsEmpty(Window(home).Property(mdm_home_repository_label))">$INFO[Window(home).Property(mdm_home_repository_label)]</value>
    <value>MDM Repo</value>
  </variable>
  <variable name="MDMHomeAccent">
    <value condition="!String.IsEmpty(Window(home).Property(mdm_home_accent))">$INFO[Window(home).Property(mdm_home_accent)]</value>
    <value>FFE50914</value>
  </variable>
  <variable name="MDMHomeAccentText">
    <value condition="!String.IsEmpty(Window(home).Property(mdm_home_accent_text))">$INFO[Window(home).Property(mdm_home_accent_text)]</value>
    <value>FFFFFFFF</value>
  </variable>
  <include name="MDMInstalledVersion">
    <definition>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>278</width>
        <height>30</height>
        <aligny>center</aligny>
        <font>font10</font>
        <textcolor>FFF0F0F0</textcolor>
        <label>MDM [COLOR $PARAM[color]]$PARAM[name][/COLOR]: $INFO[System.AddonVersion($PARAM[id])]</label>
        <visible>!String.IsEmpty(System.AddonVersion($PARAM[id]))</visible>
      </control>
    </definition>
  </include>
  <include name="MDMInstalledVersions">
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>125</height>
      <texture colordiffuse="E6101014">colors/white.png</texture>
    </control>
    <include content="MDMInstalledVersion">
      <param name="id" value="plugin.video.mdm.flix" />
      <param name="name" value="Flix" />
      <param name="color" value="FFC78CFF" />
      <param name="left" value="350" />
      <param name="top" value="42" />
    </include>
    <include content="MDMInstalledVersion">
      <param name="id" value="script.mdm.link" />
      <param name="name" value="Link" />
      <param name="color" value="FFF2E85E" />
      <param name="left" value="632" />
      <param name="top" value="42" />
    </include>
    <include content="MDMInstalledVersion">
      <param name="id" value="script.mdm.core" />
      <param name="name" value="Core" />
      <param name="color" value="FF88ACFF" />
      <param name="left" value="914" />
      <param name="top" value="42" />
    </include>
    <include content="MDMInstalledVersion">
      <param name="id" value="script.mdm.conf" />
      <param name="name" value="Conf" />
      <param name="color" value="FF9DE76D" />
      <param name="left" value="1196" />
      <param name="top" value="42" />
    </include>
    <include content="MDMInstalledVersion">
      <param name="id" value="skin.mdm.skin" />
      <param name="name" value="Skin" />
      <param name="color" value="FFFFAB68" />
      <param name="left" value="350" />
      <param name="top" value="76" />
    </include>
    <include content="MDMInstalledVersion">
      <param name="id" value="repository.mdm.repo" />
      <param name="name" value="Repo" />
      <param name="color" value="FFFF8188" />
      <param name="left" value="632" />
      <param name="top" value="76" />
    </include>
    <include content="MDMInstalledVersion">
      <param name="id" value="repository.mdm.repo.dev" />
      <param name="name" value="Dev Repo" />
      <param name="color" value="FFFF8188" />
      <param name="left" value="914" />
      <param name="top" value="76" />
    </include>
  </include>
  <include name="MDMHomeCard">
    <control type="image">
      <left>4</left>
      <top>4</top>
      <width>184</width>
      <height>104</height>
      <texture colordiffuse="FF25252C">colors/white.png</texture>
    </control>
    <control type="image">
      <left>4</left>
      <top>4</top>
      <width>184</width>
      <height>104</height>
      <aspectratio>scale</aspectratio>
      <texture fallback="DefaultVideo.png" background="true">$VAR[MDMHomeCardArt]</texture>
    </control>
    <control type="label">
      <left>4</left>
      <top>109</top>
      <width>184</width>
      <height>30</height>
      <aligny>center</aligny>
      <font>font10</font>
      <textcolor>FFF0F0F0</textcolor>
      <label>$INFO[ListItem.Label]</label>
    </control>
  </include>
  <include name="MDMHomeRailLayout">
    <left>420</left>
    <width>1440</width>
    <height>141</height>
    <orientation>horizontal</orientation>
    <onright>noop</onright>
    <visible>true</visible>
    <itemlayout width="205" height="141">
      <include>MDMHomeCard</include>
    </itemlayout>
    <focusedlayout width="205" height="141">
      <control type="image">
        <left>0</left>
        <top>0</top>
        <width>192</width>
        <height>112</height>
        <texture colordiffuse="$VAR[MDMHomeAccent]">colors/white.png</texture>
      </control>
      <include>MDMHomeCard</include>
    </focusedlayout>
  </include>
  <variable name="MDMHomeCardArt">
    <value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
    <value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
    <value>$INFO[ListItem.Art(poster)]</value>
  </variable>
  <include name="MDMArtworkHome">
    <control type="image">
      <left>1040</left>
      <top>133</top>
      <width>820</width>
      <height>223</height>
      <aspectratio>scale</aspectratio>
      <texture background="true">$VAR[MDMFeaturedArt]</texture>
    </control>
    <control type="label">
      <left>420</left>
      <top>133</top>
      <width>575</width>
      <height>35</height>
      <font>font10</font>
      <textcolor>FFC8C8CE</textcolor>
      <label>FEATURED</label>
      <visible>Integer.IsGreater(Container(5300).NumItems,0) | Integer.IsGreater(Container(5400).NumItems,0) | Integer.IsGreater(Container(5100).NumItems,0) | Integer.IsGreater(Container(5200).NumItems,0)</visible>
    </control>
    <control type="label">
      <left>420</left>
      <top>171</top>
      <width>595</width>
      <height>63</height>
      <font>font45</font>
      <textcolor>FFFFFFFF</textcolor>
      <label>$VAR[MDMFeaturedTitle]</label>
      <scroll>true</scroll>
    </control>
    <control type="textbox">
      <left>420</left>
      <top>242</top>
      <width>595</width>
      <height>112</height>
      <font>font12</font>
      <textcolor>FFE2E2E6</textcolor>
      <label>$VAR[MDMFeaturedPlot]</label>
    </control>
    <control type="label">
      <left>420</left>
      <top>363</top>
      <width>1400</width>
      <height>31</height>
      <font>font27</font>
      <textcolor>FFFFFFFF</textcolor>
      <label>Continue Watching</label>
    </control>
    <control type="list" id="5300">
      <include>MDMHomeRailLayout</include>
      <top>397</top>
      <onleft>103</onleft>
      <onback>103</onback>
      <onup>103</onup>
      <ondown condition="Integer.IsGreater(Container(5400).NumItems,0)">5400</ondown>
      <ondown condition="Integer.IsGreater(Container(5100).NumItems,0) + !Integer.IsGreater(Container(5400).NumItems,0)">5100</ondown>
      <ondown condition="Integer.IsGreater(Container(5200).NumItems,0) + !Integer.IsGreater(Container(5400).NumItems,0) + !Integer.IsGreater(Container(5100).NumItems,0)">5200</ondown>
      <ondown condition="!Integer.IsGreater(Container(5400).NumItems,0) + !Integer.IsGreater(Container(5100).NumItems,0) + !Integer.IsGreater(Container(5200).NumItems,0)">103</ondown>
      <content target="videos" limit="12" browse="never">$VAR[MDMWidgetContinueURL]</content>
    </control>
    <control type="label">
      <left>424</left>
      <top>416</top>
      <width>1250</width>
      <height>40</height>
      <font>font10</font>
      <textcolor>FFA7A7B0</textcolor>
      <label>Watch a title to pick up here.</label>
      <visible>!Container(5300).IsUpdating + Integer.IsEqual(Container(5300).NumItems,0)</visible>
    </control>
    <control type="label">
      <left>420</left>
      <top>535</top>
      <width>1400</width>
      <height>31</height>
      <font>font27</font>
      <textcolor>FFFFFFFF</textcolor>
      <label>$VAR[MDMHomeListLabel]</label>
    </control>
    <control type="list" id="5400">
      <include>MDMHomeRailLayout</include>
      <top>569</top>
      <onleft>105</onleft>
      <onback>105</onback>
      <onup condition="Integer.IsGreater(Container(5300).NumItems,0)">5300</onup>
      <onup condition="!Integer.IsGreater(Container(5300).NumItems,0)">105</onup>
      <ondown condition="Integer.IsGreater(Container(5100).NumItems,0)">5100</ondown>
      <ondown condition="Integer.IsGreater(Container(5200).NumItems,0) + !Integer.IsGreater(Container(5100).NumItems,0)">5200</ondown>
      <ondown condition="!Integer.IsGreater(Container(5100).NumItems,0) + !Integer.IsGreater(Container(5200).NumItems,0)">105</ondown>
      <content target="videos" limit="12" browse="never">$VAR[MDMWidgetListURL]</content>
    </control>
    <control type="label">
      <left>424</left>
      <top>588</top>
      <width>1250</width>
      <height>40</height>
      <font>font10</font>
      <textcolor>FFA7A7B0</textcolor>
      <label>Save titles to this list to see them here.</label>
      <visible>!Container(5400).IsUpdating + Integer.IsEqual(Container(5400).NumItems,0)</visible>
    </control>
    <control type="label">
      <left>420</left>
      <top>707</top>
      <width>1400</width>
      <height>31</height>
      <font>font27</font>
      <textcolor>FFFFFFFF</textcolor>
      <label>Trending films</label>
    </control>
    <control type="list" id="5100">
      <include>MDMHomeRailLayout</include>
      <top>741</top>
      <onleft>100</onleft>
      <onback>100</onback>
      <onup condition="Integer.IsGreater(Container(5400).NumItems,0)">5400</onup>
      <onup condition="Integer.IsGreater(Container(5300).NumItems,0) + !Integer.IsGreater(Container(5400).NumItems,0)">5300</onup>
      <onup condition="!Integer.IsGreater(Container(5400).NumItems,0) + !Integer.IsGreater(Container(5300).NumItems,0)">100</onup>
      <ondown condition="Integer.IsGreater(Container(5200).NumItems,0)">5200</ondown>
      <ondown condition="!Integer.IsGreater(Container(5200).NumItems,0)">100</ondown>
      <content target="videos" limit="12" browse="never">$VAR[MDMWidgetMovieURL]</content>
    </control>
    <control type="label">
      <left>424</left>
      <top>760</top>
      <width>1250</width>
      <height>40</height>
      <font>font10</font>
      <textcolor>FFA7A7B0</textcolor>
      <label>No films to show yet.</label>
      <visible>!Container(5100).IsUpdating + Integer.IsEqual(Container(5100).NumItems,0)</visible>
    </control>
    <control type="label">
      <left>420</left>
      <top>879</top>
      <width>1400</width>
      <height>31</height>
      <font>font27</font>
      <textcolor>FFFFFFFF</textcolor>
      <label>Trending TV</label>
    </control>
    <control type="list" id="5200">
      <include>MDMHomeRailLayout</include>
      <top>913</top>
      <onleft>101</onleft>
      <onback>101</onback>
      <onup condition="Integer.IsGreater(Container(5100).NumItems,0)">5100</onup>
      <onup condition="Integer.IsGreater(Container(5400).NumItems,0) + !Integer.IsGreater(Container(5100).NumItems,0)">5400</onup>
      <onup condition="Integer.IsGreater(Container(5300).NumItems,0) + !Integer.IsGreater(Container(5100).NumItems,0) + !Integer.IsGreater(Container(5400).NumItems,0)">5300</onup>
      <onup condition="!Integer.IsGreater(Container(5100).NumItems,0) + !Integer.IsGreater(Container(5400).NumItems,0) + !Integer.IsGreater(Container(5300).NumItems,0)">101</onup>
      <ondown>101</ondown>
      <content target="videos" limit="12" browse="never">$VAR[MDMWidgetTVURL]</content>
    </control>
    <control type="label">
      <left>424</left>
      <top>932</top>
      <width>1250</width>
      <height>40</height>
      <font>font10</font>
      <textcolor>FFA7A7B0</textcolor>
      <label>No shows to show yet.</label>
      <visible>!Container(5200).IsUpdating + Integer.IsEqual(Container(5200).NumItems,0)</visible>
    </control>
  </include>
  <variable name="MDMFeaturedTitle">
    <value condition="Control.HasFocus(5300)">$INFO[Container(5300).ListItem.Label]</value>
    <value condition="Control.HasFocus(5400)">$INFO[Container(5400).ListItem.Label]</value>
    <value condition="Control.HasFocus(5100)">$INFO[Container(5100).ListItem.Label]</value>
    <value condition="Control.HasFocus(5200)">$INFO[Container(5200).ListItem.Label]</value>
    <value condition="Integer.IsGreater(Container(5100).NumItems,0)">$INFO[Container(5100).ListItem.Label]</value>
    <value condition="Integer.IsGreater(Container(5200).NumItems,0)">$INFO[Container(5200).ListItem.Label]</value>
    <value condition="Integer.IsGreater(Container(5300).NumItems,0)">$INFO[Container(5300).ListItem.Label]</value>
    <value condition="Integer.IsGreater(Container(5400).NumItems,0)">$INFO[Container(5400).ListItem.Label]</value>
    <value>Find your next watch</value>
  </variable>
  <variable name="MDMFeaturedPlot">
    <value condition="Control.HasFocus(5300)">$INFO[Container(5300).ListItem.Plot]</value>
    <value condition="Control.HasFocus(5400)">$INFO[Container(5400).ListItem.Plot]</value>
    <value condition="Control.HasFocus(5100)">$INFO[Container(5100).ListItem.Plot]</value>
    <value condition="Control.HasFocus(5200)">$INFO[Container(5200).ListItem.Plot]</value>
    <value condition="Integer.IsGreater(Container(5100).NumItems,0)">$INFO[Container(5100).ListItem.Plot]</value>
    <value condition="Integer.IsGreater(Container(5200).NumItems,0)">$INFO[Container(5200).ListItem.Plot]</value>
    <value condition="Integer.IsGreater(Container(5300).NumItems,0)">$INFO[Container(5300).ListItem.Plot]</value>
    <value condition="Integer.IsGreater(Container(5400).NumItems,0)">$INFO[Container(5400).ListItem.Plot]</value>
    <value>Choose a title below or use Search to find something new.</value>
  </variable>
  <variable name="MDMFeaturedArt">
    <value condition="Control.HasFocus(5300)">$INFO[Container(5300).ListItem.Art(fanart)]</value>
    <value condition="Control.HasFocus(5400)">$INFO[Container(5400).ListItem.Art(fanart)]</value>
    <value condition="Control.HasFocus(5100)">$INFO[Container(5100).ListItem.Art(fanart)]</value>
    <value condition="Control.HasFocus(5200)">$INFO[Container(5200).ListItem.Art(fanart)]</value>
    <value condition="Integer.IsGreater(Container(5100).NumItems,0)">$INFO[Container(5100).ListItem.Art(fanart)]</value>
    <value condition="Integer.IsGreater(Container(5200).NumItems,0)">$INFO[Container(5200).ListItem.Art(fanart)]</value>
    <value condition="Integer.IsGreater(Container(5300).NumItems,0)">$INFO[Container(5300).ListItem.Art(fanart)]</value>
    <value condition="Integer.IsGreater(Container(5400).NumItems,0)">$INFO[Container(5400).ListItem.Art(fanart)]</value>
    <value />
  </variable>
  <variable name="MDMWidgetMovieURL">
    <value condition="Skin.HasSetting(device_mdm_artwork) + !String.IsEmpty(Window(home).Property(mdm_widget_mode))">plugin://plugin.video.mdm.flix/?action=skin_widget&amp;media_type=movie&amp;mode=$INFO[Window(home).Property(mdm_widget_mode)]</value>
    <value />
  </variable>
  <variable name="MDMWidgetTVURL">
    <value condition="Skin.HasSetting(device_mdm_artwork) + !String.IsEmpty(Window(home).Property(mdm_widget_mode))">plugin://plugin.video.mdm.flix/?action=skin_widget&amp;media_type=tv&amp;mode=$INFO[Window(home).Property(mdm_widget_mode)]</value>
    <value />
  </variable>
  <variable name="MDMWidgetContinueURL">
    <value condition="Skin.HasSetting(device_mdm_artwork) + !String.IsEmpty(Window(home).Property(mdm_widget_mode))">plugin://plugin.video.mdm.flix/?action=skin_widget&amp;row=continue&amp;mode=$INFO[Window(home).Property(mdm_widget_mode)]&amp;revision=$INFO[Window(home).Property(mdm_home_continue_revision)]</value>
    <value />
  </variable>
  <variable name="MDMWidgetListURL">
    <value condition="Skin.HasSetting(device_mdm_artwork) + !String.IsEmpty(Window(home).Property(mdm_widget_mode))">plugin://plugin.video.mdm.flix/?action=skin_widget&amp;row=my_list&amp;mode=$INFO[Window(home).Property(mdm_widget_mode)]&amp;revision=$INFO[Window(home).Property(mdm_home_my_list_revision)]</value>
    <value />
  </variable>
</includes>
