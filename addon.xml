<?xml version='1.0' encoding='utf-8'?>
<addon id="skin.mdm.skin" name="MDM Skin" version="0.3.1" provider-name="MDMAinsley">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
    <import addon="xbmc.gui" version="5.17.0" />
    <import addon="plugin.video.mdm.flix" version="0.10.0" />
  </requires>
  <extension point="xbmc.gui.skin">
    <res width="1920" height="1440" aspect="4:3" default="false" folder="xml" />
    <res width="1920" height="1280" aspect="3:2" default="false" folder="xml" />
    <res width="1920" height="1200" aspect="16:10" default="false" folder="xml" />
    <res width="2040" height="1080" aspect="17:9" default="false" folder="xml" />
    <res width="1920" height="1080" aspect="16:9" default="true" folder="xml" />
    <res width="2560" height="1080" aspect="21:9" default="false" folder="xml" />
    <res width="2338" height="1080" aspect="19.5:9" default="false" folder="xml" />
    <res width="2160" height="1080" aspect="18:9" default="false" folder="xml" />
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary>MDM artwork home with an adaptive basic mode</summary>
    <description>Kodi 21/22 development skin: movie/TV artwork rows, Flix navigation, setup and standard Kodi playback controls. Personal lists and ratings are provided by Flix 0.9.0; viewing progress remains planned.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
    <license>GPL-2.0; CC-BY-SA-4.0; font licenses in fonts/</license>
    <source>https://github.com/MDMAinsley/skin.mdm.skin</source>
  </extension>
</addon>